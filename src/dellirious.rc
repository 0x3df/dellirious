#include <windows.h>

1 VERSIONINFO
FILEVERSION 2,6,0,0
PRODUCTVERSION 2,6,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Dell Technologies"
      VALUE "FileDescription", "Dell DBUtil Diagnostic Utility"
      VALUE "InternalName", "dbutil_diag"
      VALUE "OriginalFilename", "dbutil_diag.exe"
      VALUE "ProductName", "Dell Diagnostic Utilities"
      VALUE "FileVersion", "2.6.0.0"
      VALUE "LegalCopyright", "(c) Dell Technologies. All rights reserved."
      VALUE "ProductVersion", "2.6.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

/* NOTE: no manifest here. The MSVC build merges src/app.manifest via
 * mt.exe (vcxproj AdditionalManifestFiles); the mingw build embeds none
 * (run as admin manually). One manifest source per toolchain - the
 * duplicate RT_MANIFEST was the CVT1100/LNK1123 cause.
 */
